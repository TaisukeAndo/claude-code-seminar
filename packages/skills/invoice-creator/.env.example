# ============================================================
# invoice-creator .env テンプレート
# このファイルを .env にコピーして実際の情報を記入してください
# .env は Git に含めず、ローカルのみで管理してください
# ============================================================

# ── 自社情報 ──────────────────────────────────────────────
MY_COMPANY_NAME=株式会社〇〇
MY_COMPANY_ZIP=100-0001
MY_COMPANY_ADDRESS=東京都千代田区〇〇1-2-3
MY_COMPANY_TEL=03-XXXX-XXXX
MY_COMPANY_FAX=03-XXXX-XXXX
MY_COMPANY_EMAIL=info@example.com

# 代表者情報
MY_REPRESENTATIVE_TITLE=代表取締役
MY_REPRESENTATIVE_NAME=山田 太郎

# インボイス制度 登録番号（Tから始まる13桁）
MY_REGISTRATION_NUMBER=T1234567890123

# 法人番号（任意）
MY_CORPORATE_NUMBER=

# ── 銀行口座情報（振込先） ──────────────────────────────────
BANK_NAME=〇〇銀行
BANK_BRANCH=〇〇支店
BANK_TYPE=普通
BANK_NUMBER=1234567
BANK_HOLDER=カブシキガイシャマルマル

# 第2口座（任意）
BANK2_NAME=
BANK2_BRANCH=
BANK2_TYPE=
BANK2_NUMBER=
BANK2_HOLDER=

# ── 印鑑・ロゴ画像 ────────────────────────────────────────
# assets/ フォルダに画像を置いてファイル名を記入
MY_SEAL_IMAGE=seal.png
MY_LOGO_IMAGE=logo.png

# ── デフォルト設定 ────────────────────────────────────────
# 消費税の計算方式: exclusive（税抜） / inclusive（税込）
DEFAULT_TAX_CALCULATION=exclusive
# デフォルト消費税率（%）
DEFAULT_TAX_RATE=10
# 文書番号の接頭辞
ESTIMATE_NUMBER_PREFIX=EST-
INVOICE_NUMBER_PREFIX=INV-
RECEIPT_NUMBER_PREFIX=REC-
